# 本地复制为 .env.local，并填入至少 32 字符的随机值。不要提交 .env.local。
# 生产环境由 Sites 作为加密环境变量注入。
APP_ENCRYPTION_KEY=

# OpenClaw Agent 配置
OPENCLAW_GATEWAY_URL=http://127.0.0.1:18789/v1
OPENCLAW_API_TOKEN=
OPENCLAW_AGENT_ID=default

# OpenClaw Agent 本地路径配置
DOCGUARD_RESULT_WRITE_ROOT=/Users/samoye/docguard-results
DOCGUARD_RESULT_AGENT_ROOT=/Users/samoye/docguard-results
DOCGUARD_UPLOAD_WRITE_ROOT=/Users/samoye/docguard-inbox
DOCGUARD_UPLOAD_AGENT_ROOT=/Users/samoye/docguard-inbox

# 日志配置
DOCGUARD_LOG_LEVEL=INFO
DOCGUARD_LOG_FILE=logs/docguard.log
DOCGUARD_LOG_RETENTION_DAYS=14

# LLM 提供商（根据实际使用的模型）
DEEPSEEK_API_KEY=
